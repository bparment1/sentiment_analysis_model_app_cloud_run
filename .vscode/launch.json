    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "justMyCode": false,
            "args": ["--input_text", "The meal service was not very good and we didn't get water",
                     "--url", "http://127.0.0.1:8000/predict"
                    ],
            "console": "integratedTerminal"
        }
    ]
}